<%- include('partials/layout-start') %>

<div class="mb-4 flex flex-col gap-2 sm:mb-5 sm:flex-row sm:items-start sm:justify-between">
  <div class="min-w-0">
    <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-400"><%= module.folder %> · <%= module.action %></p>
    <h1 class="mt-1 text-xl font-semibold tracking-tight text-slate-900 sm:text-2xl"><%= module.name %></h1>
    <p class="mt-1 max-w-2xl text-sm text-slate-500"><%= module.description %></p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <code class="rounded-md border border-slate-200 bg-white px-2 py-1 font-mono text-[11px] text-slate-600"><%= module.method %> <%= module.path %></code>
    <button type="button" id="openRawBtn" class="hidden rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50">
      View raw API
    </button>
  </div>
</div>

<details id="filtersPanel" class="filters-panel mb-4 overflow-visible rounded-xl border border-slate-200 bg-white shadow-panel sm:mb-5">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-t-xl bg-slate-50/80 px-4 py-3 hover:bg-slate-50 sm:px-5">
    <div class="min-w-0">
      <h2 class="text-sm font-semibold text-slate-900">Filters</h2>
      <p class="mt-0.5 text-xs text-slate-500">Collapsed by default — expand to edit query parameters</p>
    </div>
    <span class="filters-chevron inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
    </span>
  </summary>

  <form
    id="moduleForm"
    class="relative z-10 overflow-visible border-t border-slate-200 p-4 sm:p-5"
    data-module-id="<%= module.id %>"
    data-danger="<%= module.danger ? '1' : '0' %>"
    data-has-cache="<%= hasCachedResults ? '1' : '0' %>"
    data-autoload="<%= module.autoload ? '1' : '0' %>"
  >
    <div class="grid gap-x-4 gap-y-3.5 sm:grid-cols-2 xl:grid-cols-3">
      <% module.fields.forEach(function (field) { %>
        <div class="<%= ['guestEmail','bookingExtent','customId','hotelId','roomTypeId','guestGivenName','guestFamilyName'].includes(field.key) ? 'sm:col-span-2 xl:col-span-3' : '' %>">
          <label for="field-<%= field.key %>" class="form-label">
            <%= field.label %><% if (field.required) { %> <span class="text-rose-500">*</span><% } %>
          </label>
          <% if (field.type === 'searchable-select') { %>
            <%- include('partials/searchable-select', { field: field }) %>
          <% } else if (field.type === 'select') { %>
            <select id="field-<%= field.key %>" name="<%= field.key %>" <%= field.required ? 'required' : '' %> class="form-control">
              <% (field.options || []).forEach(function (opt) { %>
                <option value="<%= opt.value %>" <%= String(opt.value) === String(field.default) ? 'selected' : '' %>><%= opt.label %></option>
              <% }) %>
            </select>
          <% } else { %>
            <input
              id="field-<%= field.key %>"
              name="<%= field.key %>"
              type="<%= field.type === 'date' ? 'date' : field.type === 'number' ? 'number' : field.type === 'email' ? 'email' : 'text' %>"
              value="<%= field.default || '' %>"
              <%= field.required ? 'required' : '' %>
              <% if (typeof field.min !== 'undefined') { %>min="<%= field.min %>"<% } %>
              autocomplete="off"
              class="form-control"
              placeholder="<%= field.help || '' %>"
            />
          <% } %>
          <% if (field.help) { %><p class="form-help"><%= field.help %></p><% } %>
        </div>
      <% }) %>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2.5 border-t border-slate-100 pt-4">
      <button
        type="submit"
        id="runBtn"
        class="inline-flex h-9 items-center justify-center rounded-lg px-4 text-sm font-semibold text-white shadow-sm transition focus:outline-none focus:ring-2 focus:ring-offset-2 <%= module.danger ? 'bg-rose-600 hover:bg-rose-700 focus:ring-rose-500' : 'bg-brand-600 hover:bg-brand-700 focus:ring-brand-500' %>"
      >
        <%= module.danger ? 'Cancel booking' : module.action === 'create' ? 'Create booking' : 'Run query' %>
      </button>
      <button type="reset" class="inline-flex h-9 items-center rounded-lg border border-slate-300 bg-white px-3.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
        Reset
      </button>
      <span id="statusLine" class="text-sm text-slate-500"></span>
    </div>
  </form>
</details>

<section id="resultsPanel" class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-panel <%= hasCachedResults ? '' : 'hidden' %>">
  <div class="flex flex-col gap-3 border-b border-slate-200 bg-slate-50/80 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-5">
    <div class="min-w-0">
      <h2 class="text-sm font-semibold text-slate-900">Results</h2>
      <p id="resultsMeta" class="mt-0.5 truncate text-xs text-slate-500">Load a query to populate this table.</p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
      <div class="relative min-w-0 flex-1 sm:w-56 lg:w-64">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z"/></svg>
        </span>
        <input id="searchInput" type="search" placeholder="Search records…" class="form-control !py-2 pl-9" />
      </div>

      <% if (module.id === 'list-hotels') { %>
        <div class="flex items-center gap-2">
          <span class="hidden text-xs font-medium text-slate-500 sm:inline">Demo</span>
          <div id="demoFilterGroup" class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 shadow-sm" role="group" aria-label="Demo hotels filter">
            <button type="button" data-demo="all" class="demo-filter-btn rounded-md px-2.5 py-1.5 text-xs font-semibold text-slate-600 transition hover:text-slate-900">All</button>
            <button type="button" data-demo="demo" class="demo-filter-btn rounded-md px-2.5 py-1.5 text-xs font-semibold text-slate-600 transition hover:text-slate-900">Demo only</button>
            <button type="button" data-demo="hide" class="demo-filter-btn rounded-md px-2.5 py-1.5 text-xs font-semibold text-slate-600 transition hover:text-slate-900">Hide demo</button>
          </div>
        </div>
      <% } %>

      <label class="flex items-center gap-2 text-xs font-medium text-slate-600">
        <span>Rows</span>
        <select id="pageSizeSelect" class="form-control !w-auto !py-2">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
        </select>
      </label>
    </div>
  </div>

  <div id="resultsContent" class="min-h-[160px]">
    <div class="flex items-center justify-center px-5 py-14 text-sm text-slate-500">No data yet. Expand filters and run a query.</div>
  </div>

  <div id="paginationBar" class="flex flex-col gap-3 border-t border-slate-200 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-5">
    <p id="pageSummary" class="text-sm text-slate-500">—</p>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" id="prevPageBtn" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40">Previous</button>
      <div id="pageNumbers" class="flex items-center gap-1"></div>
      <button type="button" id="nextPageBtn" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-40">Next</button>
    </div>
  </div>
</section>

<%- include('partials/layout-end', { pageScript: '/js/module.js' }) %>
