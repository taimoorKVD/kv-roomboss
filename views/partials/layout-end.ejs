        </div>
      </main>
    </div>
  </div>

  <aside id="jsonDrawer" class="json-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="jsonDrawerTitle">
    <div class="flex h-14 shrink-0 items-center justify-between gap-3 border-b border-slate-800 px-4">
      <div class="min-w-0">
        <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Payload inspector</p>
        <h2 id="jsonDrawerTitle" class="truncate text-sm font-semibold text-white">API response</h2>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" id="jsonCopyBtn" class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs font-medium text-slate-200 hover:bg-slate-800">
          Copy
        </button>
        <button type="button" id="jsonDrawerClose" class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white" aria-label="Close drawer">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <pre id="jsonDrawerBody" class="scrollbar-dark flex-1 overflow-auto p-4 font-mono text-[12px] leading-relaxed text-slate-200"></pre>
  </aside>

  <%- include('action-drawer') %>
  <%- include('account-modals') %>

  <div id="toast" class="toast-stack pointer-events-none fixed bottom-4 right-4 z-[70] flex max-w-[min(22rem,calc(100vw-2rem))] flex-col gap-2" aria-live="polite"></div>
  <script src="/js/app.js"></script>
  <script src="/js/accounts.js"></script>
  <script src="/js/searchable-select.js"></script>
  <script src="/js/action-drawer.js"></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
  <script src="<%= pageScript %>"></script>
  <% } %>
</body>
</html>
