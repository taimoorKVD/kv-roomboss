<%- include('partials/layout-start') %>

<div class="mb-8">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">Operations console</h1>
  <p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-600 sm:text-base">
    Enterprise-ready RoomBoss workflows for domain users. Run listings, search and paginate results,
    then open any record for a full detail view — without Postman.
  </p>
</div>

<div class="mb-8 grid gap-4 sm:grid-cols-3">
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-panel">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Step 01</p>
    <p class="mt-2 text-sm font-medium text-slate-900">Select API account</p>
    <p class="mt-1 text-sm text-slate-500">AGENT ONE, JSE, or Staging from the sidebar.</p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-panel">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Step 02</p>
    <p class="mt-2 text-sm font-medium text-slate-900">Run a listing module</p>
    <p class="mt-1 text-sm text-slate-500">Fill filters and load data into a searchable table.</p>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-panel">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Step 03</p>
    <p class="mt-2 text-sm font-medium text-slate-900">Open record detail</p>
    <p class="mt-1 text-sm text-slate-500">Inspect every field, nested lists, and related IDs.</p>
  </div>
</div>

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  <% modules.forEach(function (m) { %>
    <a
      href="/modules/<%= m.id %>"
      class="group rounded-xl border border-slate-200 bg-white p-5 shadow-panel transition hover:border-brand-300 hover:shadow-md"
    >
      <div class="flex items-start justify-between gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg <%= m.danger ? 'bg-rose-50 text-rose-700' : 'bg-brand-50 text-brand-700' %>">
          <%- include('partials/icon', { icon: m.icon }) %>
        </div>
        <span class="rounded-md px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide <%= m.danger ? 'bg-rose-50 text-rose-700' : 'bg-slate-100 text-slate-600' %>">
          <%= m.action %>
        </span>
      </div>
      <h2 class="mt-4 text-base font-semibold text-slate-900 group-hover:text-brand-700"><%= m.name %></h2>
      <p class="mt-1.5 text-sm leading-relaxed text-slate-500"><%= m.description %></p>
      <p class="mt-4 text-sm font-medium text-brand-600">Open module →</p>
    </a>
  <% }) %>
</div>

<%- include('partials/layout-end') %>
