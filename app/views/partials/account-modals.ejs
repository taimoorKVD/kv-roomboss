<div id="modalBackdrop" class="modal-backdrop" aria-hidden="true"></div>

<div id="accountFormModal" class="sys-modal" role="dialog" aria-modal="true" aria-labelledby="accountFormTitle" aria-hidden="true">
  <div class="sys-modal-panel">
    <div class="sys-modal-header flex items-start justify-between gap-3 border-b border-slate-200 px-4 py-3 sm:px-5 sm:py-3.5">
      <div class="min-w-0">
        <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400">Account authorization</p>
        <h2 id="accountFormTitle" class="mt-0.5 text-base font-semibold text-slate-900">Add account</h2>
      </div>
      <button type="button" class="modal-close inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700" data-close-modal aria-label="Close">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="accountForm" class="sys-modal-body space-y-3 px-4 py-3.5 sm:px-5 sm:py-4">
      <input type="hidden" id="accountFormId" name="id" />
      <div>
        <label for="accountFormName" class="form-label">Account name <span class="text-rose-500">*</span></label>
        <input id="accountFormName" name="shortLabel" class="form-control" required maxlength="60" placeholder="e.g. Agent One" />
      </div>
      <div>
        <label for="accountFormUsername" class="form-label">Username <span class="text-rose-500">*</span></label>
        <input id="accountFormUsername" name="username" class="form-control font-mono text-sm" required autocomplete="off" />
      </div>
      <div>
        <label for="accountFormPassword" class="form-label">Password <span class="text-rose-500">*</span></label>
        <div class="relative">
          <input id="accountFormPassword" name="password" type="password" class="form-control pr-10 font-mono text-sm" required autocomplete="new-password" />
          <button type="button" id="accountFormPasswordToggle" class="absolute inset-y-0 right-0 px-3 text-xs font-semibold text-slate-500 hover:text-slate-800">Show</button>
        </div>
      </div>
      <div>
        <label for="accountFormBaseUrl" class="form-label">API base URL <span class="text-rose-500">*</span></label>
        <input id="accountFormBaseUrl" name="baseUrl" class="form-control font-mono text-sm" required value="https://api.roomboss.com" />
        <p class="form-help">Production: api.roomboss.com · Staging: api.staging.roomboss.com</p>
      </div>
      <div>
        <label for="accountFormDescription" class="form-label">Description</label>
        <input id="accountFormDescription" name="description" class="form-control" maxlength="120" placeholder="Optional note" />
      </div>
      <p id="accountFormStatus" class="text-sm text-slate-500"></p>
    </form>

    <div class="sys-modal-footer flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 bg-slate-50 px-4 py-3 sm:px-5">
      <button type="button" id="accountTestBtn" class="inline-flex h-9 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-wait disabled:opacity-70">
        Test with RoomBoss
      </button>
      <div class="footer-actions flex items-center gap-2">
        <button type="button" class="modal-close inline-flex h-9 items-center justify-center rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-60" data-close-modal>Cancel</button>
        <button type="button" id="accountSaveBtn" class="inline-flex h-9 min-w-[8.5rem] items-center justify-center gap-2 rounded-lg bg-brand-600 px-3.5 text-sm font-semibold text-white hover:bg-brand-700 disabled:cursor-wait disabled:opacity-90">
          Save account
        </button>
      </div>
    </div>
  </div>
</div>

<div id="confirmModal" class="sys-modal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle" aria-hidden="true">
  <div class="sys-modal-panel max-w-md">
    <div class="sys-modal-body px-4 py-4 sm:px-5">
      <h2 id="confirmTitle" class="text-base font-semibold text-slate-900">Confirm</h2>
      <p id="confirmMessage" class="mt-2 text-sm leading-relaxed text-slate-600"></p>
    </div>
    <div class="sys-modal-footer flex justify-end gap-2 border-t border-slate-200 bg-slate-50 px-4 py-3 sm:px-5">
      <button type="button" id="confirmCancelBtn" class="inline-flex h-9 items-center justify-center rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</button>
      <button type="button" id="confirmOkBtn" class="inline-flex h-9 items-center justify-center rounded-lg bg-rose-600 px-3.5 text-sm font-semibold text-white hover:bg-rose-700">Remove</button>
    </div>
  </div>
</div>
