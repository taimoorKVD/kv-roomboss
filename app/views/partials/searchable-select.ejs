<%
  const fieldId = 'field-' + field.key;
  const selected = field.options.find(function (o) { return String(o.value) === String(field.default || ''); }) || field.options[0];
  const selectedLabel = selected ? selected.label : (field.default || 'Select…');
  const selectedValue = selected ? selected.value : (field.default || '');
%>
<div
  class="searchable-select relative"
  data-searchable-select
  data-name="<%= field.key %>"
  data-required="<%= field.required ? '1' : '0' %>"
>
  <input type="hidden" id="<%= fieldId %>" name="<%= field.key %>" value="<%= selectedValue %>" <%= field.required ? 'required' : '' %> />
  <button
    type="button"
    class="searchable-select-trigger form-control flex w-full items-center justify-between gap-2 text-left"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <span class="searchable-select-label min-w-0 truncate"><%= selectedLabel %></span>
    <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
  </button>
  <div class="searchable-select-panel absolute left-0 right-0 z-50 mt-1 hidden overflow-hidden rounded-lg border border-slate-200 bg-white shadow-xl">
    <div class="border-b border-slate-100 p-2">
      <input
        type="search"
        class="searchable-select-search form-control !py-1.5"
        placeholder="Search location…"
        autocomplete="off"
      />
    </div>
    <ul class="searchable-select-list max-h-48 overflow-y-auto py-1" role="listbox">
      <% field.options.forEach(function (opt) { %>
        <li>
          <button
            type="button"
            role="option"
            class="searchable-select-option flex w-full items-center px-3 py-2 text-left text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-800 <%= String(opt.value) === String(selectedValue) ? 'bg-brand-50 font-semibold text-brand-800' : '' %>"
            data-value="<%= opt.value %>"
            data-label="<%= opt.label %>"
          >
            <%= opt.label %>
          </button>
        </li>
      <% }) %>
    </ul>
    <p class="searchable-select-empty hidden px-3 py-2 text-xs text-slate-500">No matches</p>
  </div>
</div>
