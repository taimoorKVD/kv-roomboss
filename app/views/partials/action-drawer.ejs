<div id="actionDrawerBackdrop" class="drawer-backdrop" aria-hidden="true"></div>

<aside
  id="actionDrawer"
  class="action-drawer"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="actionDrawerTitle"
>
  <div class="flex h-14 shrink-0 items-center justify-between gap-3 border-b border-slate-200 bg-white px-4">
    <div class="min-w-0">
      <p id="actionDrawerEyebrow" class="truncate text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400">Hotel action</p>
      <h2 id="actionDrawerTitle" class="truncate text-sm font-semibold text-slate-900">Action</h2>
    </div>
    <button type="button" id="actionDrawerClose" class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Close drawer">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <div id="actionDrawerContext" class="shrink-0 border-b border-slate-200 bg-slate-50 px-4 py-3 text-xs text-slate-600"></div>

  <div class="scrollbar-light flex min-h-0 flex-1 flex-col overflow-y-auto">
    <form id="actionDrawerForm" class="action-form-grid border-b border-slate-200 p-4"></form>

    <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 bg-white px-4 py-3">
      <button type="button" id="actionDrawerSubmit" class="inline-flex h-9 min-w-[8rem] items-center justify-center gap-2 rounded-lg bg-brand-600 px-3.5 text-sm font-semibold text-white hover:bg-brand-700 disabled:cursor-wait disabled:opacity-90">
        Run
      </button>
      <button type="button" id="actionDrawerReset" class="inline-flex h-9 items-center rounded-lg border border-slate-300 bg-white px-3 text-sm font-medium text-slate-700 hover:bg-slate-50">
        Reset
      </button>
      <span id="actionDrawerStatus" class="text-sm text-slate-500"></span>
    </div>

    <div id="actionDrawerResults" class="hidden flex-1 p-4">
      <div class="mb-2 flex items-center justify-between gap-2">
        <h3 class="text-sm font-semibold text-slate-900">Results</h3>
        <button type="button" id="actionDrawerRawBtn" class="hidden text-xs font-semibold text-brand-700 hover:text-brand-800">View raw</button>
      </div>
      <div id="actionDrawerResultsBody" class="overflow-hidden rounded-lg border border-slate-200 bg-white"></div>
    </div>
  </div>
</aside>

<script type="application/json" id="modulesConfigData"><%- JSON.stringify(modulesConfig).replace(/</g, '\\u003c') %></script>
